Options -Indexes

<Files ".env">
  Require all denied
</Files>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,END]
  RewriteRule ^admin/acceso/?$ admin/entradas/acceso/index.html [QSA,L]
  RewriteRule ^admin/descuentos/?$ admin/descuentos/index.html [QSA,L]
  RewriteRule ^admin/eventos/([0-9]+)/editar/?$ admin/entradas/evento/index.html?id=$1 [QSA,L]
  RewriteRule ^eventos/([a-z0-9-]+)/?$ eventos/evento.html?slug=$1 [QSA,L]
</IfModule>
