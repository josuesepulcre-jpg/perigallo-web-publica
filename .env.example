APP_ENV=production
APP_BASE_URL=https://perigallo.com
APP_TIMEZONE=Europe/Madrid
APP_SECRET=
# Clave privada distinta de cualquier secreto de pago. Generar con: openssl rand -base64 48
TICKET_QR_ENCRYPTION_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=perigallo_ticketing
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Cuenta opcional exclusiva para el acceso al evento. Puede escanear y consultar
# resultados, pero no editar eventos, pedidos ni revertir accesos.
ACCESS_USERNAME=
ACCESS_PASSWORD_HASH=

REDSYS_ENV=test
PAYMENT_ENVIRONMENT=sandbox
# La vista previa privada solo puede abrir Redsys TEST cuando ambas variables mantienen estos valores.
REDSYS_TEST_URL=https://sis-t.redsys.es:25443/sis/realizarPago
REDSYS_PRODUCTION_URL=https://sis.redsys.es/sis/realizarPago
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_CURRENCY=978
# Clave exclusiva del entorno de pruebas.
REDSYS_TEST_SECRET_KEY=
# Clave exclusiva del entorno REAL. Nunca reutilizar la de pruebas.
REDSYS_PRODUCTION_SECRET_KEY=
# Legacy temporal. DEPRECATED. Eliminar cuando termine la migración.
REDSYS_SECRET_KEY=
REDSYS_SIGNATURE_VERSION=HMAC_SHA256_V1
REDSYS_TRANSACTION_TYPE=0
# Activar solo cuando CaixaBank/Redsys haya habilitado Bizum para este mismo terminal.
REDSYS_BIZUM_ENABLED=false
TICKET_RESERVATION_MINUTES=30

# Holded queda desactivado durante la preparación. No cambies estas dos líneas
# hasta completar la revisión fiscal, las pruebas end-to-end y la activación expresa.
HOLDED_ENABLED=false
HOLDED_DRY_RUN=true
HOLDED_ENV=production
HOLDED_API_KEY=
HOLDED_PAYMENT_METHOD_ID=
HOLDED_SALES_ACCOUNT_ID=
HOLDED_TREASURY_ID=
HOLDED_INVOICE_SERIES_ID=
HOLDED_SALES_RECEIPT_SERIES_ID=
# Debe coincidir con la tasa del impuesto indicado en HOLDED_DEFAULT_TAX_ID.
HOLDED_DEFAULT_TAX_RATE=
HOLDED_DEFAULT_TAX_ID=
HOLDED_SIMPLIFIED_MAX_CENTS=40000
# Requiere HOLDED_AUTO_APPROVE=true. Envía al correo fiscal el enlace seguro de una factura nominal aprobada.
HOLDED_AUTO_SEND_EMAIL=false
HOLDED_AUTO_APPROVE=false

# API privada Suite <-> ticketing. Debe ser un secreto largo distinto de las credenciales públicas.
SUITE_TICKETING_API_KEY=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=entradas@perigallo.com
MAIL_FROM_NAME=Perigallo
MAIL_SECURE=tls

# Destinatario inicial opcional. Después puede configurarse desde /admin/analitica/.
ANALYTICS_REPORT_EMAIL=

# WhatsApp se activa solo con un proveedor transaccional y una plantilla aprobada.
# Valores admitidos: meta_cloud. Para marcarlo como enviado, Meta debe aceptar la plantilla.
WHATSAPP_PROVIDER=
WHATSAPP_AUTO_SEND=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=es
